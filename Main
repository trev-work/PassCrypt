from Crypto.Cipher import AES
import Crypto.Random
from cryptography.hazmat.backends import default_backend
from cryptography.hazmat.primitives.kdf.argon2 import Argon2id
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

mode = AES.MODE_CBC
trusted = False

#creates an array
w, h = 2, 16
passwords = []

#Create a Fingerprint!
def newkey():
   global key
   rawkey = input("Enter new encryption key: ").encode("utf-8")
   while True:
      salt = input("Enter a salt: ").encode("utf-8")
      if len(salt) < 8:
         print("Must be at least 8 bytes!")
      else:
         break

   # For key derivation
   kdf = Argon2id(
      salt = salt,
      length = 32,
      iterations = 1,
      lanes = 4,
      memory_cost = 32,
   )

   # Fingerprinting
   key = kdf.derive(rawkey)

   print(f"Key Generated!: {key}")
   menu()
   return key

#Decrypt!
def decryptor(passwd, IV):
   global key
   global trusted

   if trusted == False:
      trykey = input("Enter key for decryption: ").encode("utf-8")
      salt = input("Enter salt for decryption: ").encode("utf-8")

      kdf = Argon2id(
         salt = salt,
         length = 32,
         iterations = 1,
         lanes = 4,
         memory_cost = 32,
      )

      attempt = kdf.derive(trykey)

      if attempt == key:
         trusted = True
         print("The key was a match!")
      else:
         print("WRONG!")

   cipher = Cipher(algorithms.AES(key), modes.CBC(IV))
   decryptor = cipher.decryptor()
   encryptor = cipher.encryptor()

   if trusted == True:
      decrypted = decryptor.update(passwd) + decryptor.finalize()
      return decrypted
   else:
      print("Did not decrypt.")
      

# Encrypt and save a password!
def passwdhash():
    global key
#set password
    try:
      IV = Crypto.Random.get_random_bytes(16)
      newpasswd = input("Enter password: ")
      cipher = Cipher(algorithms.AES(key), modes.CBC(IV))
      encryptor = cipher.encryptor()
      padded = newpasswd.rjust(64, ' ')
      encrypted = encryptor.update(padded.encode("utf-8")) + encryptor.finalize()
      passwords.append([encrypted, IV])
      print(f"success! Added password: {encrypted}")
      menu()
    except NameError:
      print("No key on file")
      newkey()



def deletepasswd():
   while True:
      try:
         option = int(input("Which password would you like to delete: "))
         del passwords[option]
         print ("Password Deleted Permanently!")
         menu()
         break
      except IndexError, ValueError:
         print ("invalid input!")
         menu()
         break

def listpasswds():
   global trusted
   print ("\nPasswords: \n")
   for i, (c, IV) in enumerate(passwords):
      decrypted = decryptor(c, IV).decode("utf-8")
      print (i, decrypted.lstrip())
   trusted = False
   menu()

def menu():
   print ("Welcome to HashCrpyt!\n\nMenu:\n" \
   "1. Add a password!\n" \
   "2. Delete a password!\n" \
   "3. List passwords!\n" \
   "4. Generate a key!\n" \
   "5. Exit!\n")

   while True:
    try:
        choice = int(input("Choose a menu option: "))
        match choice:
           case 1:
              passwdhash()
              break
           case 2:
              deletepasswd()
              break
           case 3:
              listpasswds()
              break
           case 4:
              newkey()
              break
           case 5:
              print("Goodbye!")
              break
           case _:
              print("Invalid option")
              (menu)
              break
    except ValueError:
        print("Invalid option")

menu()